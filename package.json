{
        "name": "next-js-app",
        "version": "0.1.0",
        "private": true,
        "packageManager": "npm@11.14.1",
        "scripts": {
                "dev": "next dev -p 3001",
                "build": "next build",
                "start": "next start",
                "lint": "eslint .",
                "format": "prettier --write .",
                "format:check": "prettier --check .",
                "test": "vitest run",
                "test:watch": "vitest",
                "test:ai": "vitest run app/lib/ai app/api/chat app/components/chat",
                "test:ai:benchmark": "vitest run app/lib/ai/benchmark.test.ts",
                "test:legacy": "vitest run tests",
                "test:e2e": "playwright test",
                "test:e2e:auth": "E2E_RUN_AUTH=1 playwright test --grep @auth",
                "test:e2e:ui": "playwright test --ui",
                "test:e2e:report": "playwright show-report",
                "test:all": "npm test && npm run test:e2e",
                "benchmark:ai": "tsx app/lib/ai/benchmark.ts",
                "workflow:setup": "cd workflows && uvx mistralai-workflows-cli setup -o . -n noor-pharmacist",
                "workflow:worker": "cd workflows/noor-pharmacist && make start-worker",
                "workflow:execute": "cd workflows/noor-pharmacist && make execute workflow=noor-pharmacist-chat input='{\"messages\":[{\"role\":\"user\",\"content\":\"Ahoj\"}]}'",
                "generate:firebase-sw": "node scripts/generate-firebase-sw.mjs",
                "setup:push-env": "node scripts/setup-push-env.mjs",
                "verify:push-env": "node scripts/verify-push-env.mjs",
                "create:favicon": "node scripts/create-favicon.mjs",
                "check:firestore": "node scripts/check-firestore.mjs",
                "check:shopify": "node scripts/check-shopify-products.mjs",
                "verify:shopify-admin": "node scripts/verify-shopify-admin.mjs",
                "verify:shopify-admin-scopes": "node scripts/check-shopify-admin-scopes.mjs",
                "verify:shopify-metafields": "node scripts/verify-shopify-metafields.mjs",
                "verify:shopify-customer-auth": "node scripts/verify-shopify-customer-auth.mjs",
                "preflight:firebase": "node scripts/preflight-firebase.mjs",
                "sync:firebase-env": "node scripts/sync-firebase-apphosting-env.mjs",
                "push:vercel-env": "node scripts/push-vercel-env.mjs",
                "deploy:firebase": "firebase deploy --only apphosting:noor-original-500",
                "deploy:production": "node scripts/deploy-production.mjs",
                "seed:product-metafields": "node scripts/seed-product-metafields.mjs"
        },
        "dependencies": {
                "@google/generative-ai": "^0.24.1",
                "clsx": "latest",
                "firebase": "^12.14.0",
                "firebase-admin": "^14.0.0",
                "framer-motion": "^12.40.0",
                "lucide-react": "0.522.0",
                "next": "^16.2.7",
                "react": "^18",
                "react-dom": "^18"
        },
        "devDependencies": {
                "@babel/preset-env": "^7.29.7",
                "@playwright/test": "^1.60.0",
                "@testing-library/jest-dom": "^6.6.3",
                "@testing-library/react": "^16.3.0",
                "@testing-library/user-event": "^14.6.1",
                "@types/node": "^20",
                "@types/react": "^18",
                "@types/react-dom": "^18",
                "autoprefixer": "^10.5.0",
                "eslint": "^9",
                "eslint-config-next": "^16.2.7",
                "eslint-config-prettier": "^10.1.8",
                "jsdom": "^26.1.0",
                "postcss": "^8",
                "prettier": "^3.8.3",
                "tailwindcss": "^3.4.1",
                "tsx": "^4.7.0",
                "typescript": "^5",
                "vitest": "^3.2.4"
        }
}
